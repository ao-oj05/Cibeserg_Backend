# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://app_user:secret_password@localhost:5432/scandev_db?schema=public"

# JWT Secret for Session Management (Minimum 32 characters)
JWT_SECRET="scandev_super_secure_jwt_secret_key_minimum_32_characters_random_string"

# Server Port
PORT=3000

# Private Storage Directory for Reports (outside public folder)
STORAGE_REPORTS_DIR="./storage/reports"

# Node Environment
NODE_ENV="development"
